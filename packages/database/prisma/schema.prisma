generator client {
  provider               = "prisma-client"
  output                 = "../src/generated"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

/// Where a video came from, and therefore which workflow it belongs to.
///
/// The two are separate pipelines that happen to share a table: an editor's
/// hand-in is scored against the campaign's other hand-ins, while a reel
/// pulled from the tracker belongs to the Instagram timeline. Without this the
/// only thing telling them apart was a convention in the file name.
enum SubmissionSource {
  EDITOR
  TRACKER
}

enum CampaignStatus {
  ACTIVE
  INACTIVE
}

/// Application user. Authentication is mobile + OTP; there are no passwords.
model User {
  id     String @id @default(cuid())
  mobile String @unique
  name   String
  role   Role   @default(EDITOR)

  /// What this editor charges per video, in rupees. Editors only: an ADMIN
  /// row is always null, and promoting an editor clears it. Null also means
  /// "not agreed yet" — an editor can be onboarded before the rate is set.
  rateCard Float?

  /// Soft-delete flag. `false` means deleted: hidden from every list and
  /// blocked from logging in. Rows are never physically removed.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Videos this user has submitted. In practice always an editor's work —
  /// an admin can submit too, but the workflow is the editor's.
  submissions VideoSubmission[]

  /// Vendor shares this user sent.
  vendorShares VendorShare[] @relation("VendorShareAuthor")

  @@index([active])
}

/// How a vendor's reply was tied back to what we sent them.
enum ReplyMatch {
  /// They used WhatsApp's reply-to, so context.id named the exact message.
  REPLIED_TO_MESSAGE
  /// No reply-to, but their number matched exactly one open share.
  SENDER_NUMBER
  /// Their number matched several open shares; which one is a guess.
  AMBIGUOUS_SENDER
  /// Nothing tied it to a share at all.
  UNMATCHED
}

/// Whether a replied post carries one of the videos we actually sent.
enum DeliveryCheck {
  /// Not compared yet — the post is not on the tracker, or has no fingerprint.
  PENDING
  /// The post is the very same file as one of the videos sent to that vendor.
  SAME_FILE
  /// Every frame of the shorter video is in the other: the same footage.
  SAME_FOOTAGE
  /// Compared, and it carries none of the videos that vendor was sent.
  DIFFERENT
  /// The post exists but has no fingerprint yet, so nothing could be compared.
  NOT_FINGERPRINTED
}

/// Whether a replied post link was found on the tracker.
enum TrackerPresence {
  /// Not looked up yet.
  PENDING
  /// The tracker holds a reel with this shortcode on this campaign.
  FOUND
  /// Looked up and absent. Either not scraped yet, or not this campaign's.
  NOT_FOUND
}

/// One Instagram post a vendor sent us on WhatsApp.
///
/// Stored on arrival, before anything is decided about it: the webhook's job is
/// to lose nothing. Whether the post exists on the tracker, and whether it
/// carries one of the videos we sent, are answered afterwards and recorded here
/// — so a reply is still readable when the tracker is down or the lookup has
/// not run.
model VendorReplyPost {
  id String @id @default(cuid())

  /// Meta's message id for the vendor's reply. Unique per post within it, so a
  /// webhook redelivery updates rather than duplicates.
  providerMessageId String

  /// The account that sent it, international digits, no "+".
  fromNumber String

  /// The post, as identified by its shortcode — the only stable part of an
  /// Instagram URL. `rawLink` keeps what the vendor actually typed.
  shortcode String
  rawLink   String
  canonicalLink String

  /// The vendor's whole message, so a human can read what they meant.
  messageBody String

  /// How this was tied back to a share, and to which one. Null share means
  /// nothing matched — the row is kept regardless.
  matchedBy ReplyMatch
  shareId   String?
  share     VendorShare? @relation(fields: [shareId], references: [id])
  vendorId  String?
  vendor    Vendor?      @relation(fields: [vendorId], references: [id])
  campaignId String?
  campaign   Campaign?   @relation(fields: [campaignId], references: [id])

  /// Whether the tracker has this post, and the reel row if it does.
  trackerPresence TrackerPresence @default(PENDING)
  reelId          String?
  reel            CampaignReel?   @relation(fields: [reelId], references: [id])
  trackerCheckedAt DateTime?

  /// Whether the post carries one of the videos that vendor was sent.
  ///
  /// The question the whole loop exists to answer: they replied with a link,
  /// but is it *our* video? Compared only against the videos sent on their own
  /// share, so a vendor cannot be credited for someone else's delivery.
  deliveryCheck DeliveryCheck @default(PENDING)
  /// The video it carries, when one was identified.
  deliveredSubmissionId String?
  deliveredSubmission   VideoSubmission? @relation(fields: [deliveredSubmissionId], references: [id])
  /// Share of the shorter video's frames in common, 0-100. Null for a file
  /// match, where the bytes are identical and frames add nothing.
  deliveredFrameShare Float?

  /// When the vendor sent it, per Meta, and when we recorded it.
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per post per message: the same link twice in one message is one
  /// post, and a redelivered webhook must not double it.
  @@unique([providerMessageId, shortcode])
  /// The admin read: what came in on a campaign, newest first.
  @@index([campaignId, createdAt])
  /// Looking a post up by what the vendor sent.
  @@index([shortcode])
  @@index([trackerPresence])
}

model Campaign {
  id           String         @id @default(cuid())
  title        String
  briefText    String?
  guidanceNote String?
  /// Business state of the campaign, independent of `active`.
  status       CampaignStatus @default(ACTIVE)

  /// Campaign in the external tracker (api-tracker.meldit.ai). The id is what
  /// the tracker knows; the name is denormalised alongside it so the list stays
  /// readable when a campaign drops out of the tracker's active feed, and
  /// because tracker names are NOT unique — the id is the only real key.
  trackerCampaignId   String?
  trackerCampaignName String?

  /// Accepted duplication %, 0-100. A submission at or above it is flagged,
  /// never blocked. Defaults to 90 — the engine's MATCH band floor.
  duplicationThreshold Float @default(90)

  /// Soft-delete flag — see User.active. Distinct from `status`: a campaign
  /// can be INACTIVE (paused) while still active (not deleted).
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cut videos editors have handed in against this brief.
  submissions VideoSubmission[]

  /// Duplicate-detection runs over this campaign's submissions.
  comparisons VideoComparison[]

  /// Vendor shares sent from this campaign's feed.
  vendorShares VendorShare[]

  /// Post links vendors replied with on WhatsApp.
  vendorReplyPosts VendorReplyPost[]

  /// Instagram reels pulled from the tracker, and the runs matching against them.
  reels     CampaignReel[]
  crossPlatformMatches CrossPlatformMatch[]
  reelMatchRuns ReelMatchRun[]

  frameSignatures VideoFrameSignature[]
  @@index([active])
  @@index([status])
  @@index([trackerCampaignId])
}

/// Where a video stands against everything that arrived on its campaign before
/// it. Assigned once on arrival by comparing the video against the campaign's
/// *baseline* (its UNIQUE and PARTIAL videos — DUPLICATEs are never compared
/// against), and revisited only on a threshold edit, the withdrawal of its
/// parent, or a rebuild. Declaration order matters: Postgres sorts an enum by
/// it, and the feed orders UNIQUE, PARTIAL, DUPLICATE.
/// See docs/superpowers/specs/2026-09-17-incremental-duplicate-detection-design.md
enum Uniqueness {
  /// Nothing in the baseline resembled it (match value below 25).
  UNIQUE
  /// Resembles a baseline video, but below the campaign threshold. Joins the
  /// baseline, because the part it does not share is footage nobody else has.
  PARTIAL
  /// At or above the campaign threshold against a baseline video. Not in the
  /// baseline: everything in it is already in its parent.
  DUPLICATE
}

/// A video an editor has handed in against a campaign brief. The file itself
/// lives in Hetzner object storage; this row is the record of it, and
/// `objectKey` is the only link between the two.
model VideoSubmission {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  /// Who uploaded it. Kept even after the account is soft-deleted, so the
  /// history of who handed in what stays readable.
  editorId String
  editor   User   @relation(fields: [editorId], references: [id])

  /// Which workflow this row belongs to. EDITOR unless it was brought in from
  /// the tracker, so every existing and future hand-in is right by default.
  source SubmissionSource @default(EDITOR)

  /// The name as it was on the uploader's disk — for display only. Never used
  /// to build `objectKey`, which is generated server-side.
  fileName String
  /// Key in the Hetzner bucket. Unique because it is generated per upload;
  /// re-uploading the same file makes a new key, never overwrites one.
  objectKey String @unique
  /// Browser-reported MIME type, replayed as the object's Content-Type so the
  /// presigned playback URL streams instead of downloading.
  contentType String
  /// Byte count measured server-side while streaming, not trusted from the
  /// client. Int is deliberate: uploads are capped below 2 GB.
  sizeBytes Int
  /// SHA-256 of the bytes, hex, measured on the same stream. Two submissions
  /// with the same digest are the same file, and are labelled duplicates of
  /// each other without asking the engine. Null for rows uploaded before the
  /// column existed.
  contentSha256 String?

  /// SHA-256 of the stored bytes, lowercase hex.
  ///
  /// Identity, not similarity: it answers "is this the very same file" and
  /// nothing weaker. That is enough to match an editor's cut against the
  /// Instagram reel of it when the reel is a straight repost — measured on
  /// this campaign, five accounts posted one file byte for byte — and it is
  /// deliberately blind to a re-encode, which is the engine's job.
  ///
  /// Null until hashed; hashing reads the object once and never again.
  contentHash String?

  /// The label, or null. Read together with `duplicationCheckedAt`:
  /// null + null = pending (will be classified by the next sweep);
  /// null + set  = unreadable (the engine could not fingerprint it — terminal
  ///               until a rebuild);
  /// set  + set  = labelled.
  uniqueness Uniqueness?

  /// Match value, 0-100: the highest max(score, containment) against any
  /// baseline video. Max not mean: a video 95% identical to one other and
  /// unrelated to eight more averages to ~12% and reads clean. Stored even
  /// when below 25 (so a threshold edit can re-label without the engine);
  /// 0 only when there was nothing to compare against. Null = not compared.
  duplicationScore Float?

  /// Mean over the same pairs. Display only — the editor's average duplicacy.
  averageDuplicationScore Float?

  /// The baseline video it scored highest against — the parent, when the
  /// label is not UNIQUE. Set whenever the baseline was non-empty, so that a
  /// threshold edit below 25 still has a parent to point at. A plain id, so
  /// it survives that submission being withdrawn.
  topMatchSubmissionId String?

  /// Derived: `uniqueness == DUPLICATE`. Kept one release for the feed and
  /// dashboard; read `uniqueness` in new code.
  overThreshold Boolean @default(false)

  duplicationCheckedAt DateTime?

  /// Soft-delete flag — see User.active. A deleted submission keeps its object
  /// in the bucket; nothing here ever removes bytes.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Comparison runs this video was an input to.
  comparisonEntries VideoComparisonEntry[]
  /// Compared pairs this video is the left-hand side of, and the right-hand
  /// side of. Two named relations because a pair points at VideoSubmission
  /// twice; which side a video lands on carries no meaning, so read both.
  comparisonPairsA VideoComparisonPair[] @relation("ComparisonPairA")
  comparisonPairsB VideoComparisonPair[] @relation("ComparisonPairB")
  /// Reel matches this video is one side of.
  reelMatchPairs   ReelMatchPair[]

  crossPlatformMatches CrossPlatformMatch[]
  frameSignatures VideoFrameSignature[]

  /// Vendor replies found to carry this video.
  deliveredInReplies VendorReplyPost[]

  @@index([campaignId, active])
  @@index([editorId])
  /// Backs the campaign feed's most-original-first ordering.
  @@index([campaignId, active, duplicationScore])
  /// The feed reads one workflow at a time, never both at once.
  @@index([campaignId, active, source])
  /// The cross-platform match: find the reel carrying these exact bytes.
  @@index([campaignId, contentHash])
  /// Backs the baseline query (UNIQUE and PARTIAL rows of a campaign).
  @@index([campaignId, active, uniqueness])
}

/// One sampled frame of one video, reduced to a 64-bit perceptual signature.
///
/// The signature is a "brighter or darker than this frame's own middle" bit
/// per cell of an 8x8 greyscale thumbnail. At that scale compression noise
/// disappears, so re-encoding a video leaves most of its signatures
/// untouched — measured on this campaign, a re-encode shared 91% of them and
/// an unrelated video shared none.
///
/// Rows are the index, not a list to walk: two videos sharing many signatures
/// are the same footage, and the query that finds them is a lookup on
/// `(campaignId, signature)` rather than a comparison of every pair. A frame
/// belongs to exactly one side — a submission or a reel, never both.
model VideoFrameSignature {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  submissionId String?
  submission   VideoSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reelId String?
  reel   CampaignReel? @relation(fields: [reelId], references: [id], onDelete: Cascade)

  /// Which sample this was, counting from the start of the video.
  position Int

  /// The 64 bits, as a signed BigInt — Postgres has no unsigned type, and the
  /// value is only ever compared for equality.
  signature BigInt

  createdAt DateTime @default(now())

  @@index([campaignId, signature])
  @@index([submissionId])
  @@index([reelId])
}

/// Which side of a cross-platform match was published first.
enum MatchOrigin {
  EDITOR
  REEL
  /// The reel carries no post date, so neither side can be shown to precede
  /// the other. Recorded rather than guessed: naming the wrong side the
  /// original accuses the wrong party of copying.
  UNKNOWN
}

/// One editor upload and one Instagram reel found to be the very same file.
///
/// Identity, not similarity — the pair shares a SHA-256, so this is a straight
/// repost rather than a resemblance. A re-encode changes every byte and is
/// invisible here by design; that case belongs to the comparison engine.
///
/// Stored rather than recomputed because hashing a campaign's thousands of
/// videos is minutes of downloads, and the answer does not change until new
/// videos arrive.
model CrossPlatformMatch {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  submissionId String
  submission   VideoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reelId String
  reel   CampaignReel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  /// The bytes both sides share, lowercase hex. Null when the match was found
  /// by frame signatures — the same footage re-encoded shares no hash.
  contentHash String?

  /// How much of the upload's footage the reel carries, 0-100. 100 for an
  /// identical file; otherwise the share of sampled frames held in common.
  frameShare Float @default(100)

  /// Which side went public first — the original.
  origin MatchOrigin

  /// Copied onto the row so the finding still reads correctly if a reel's
  /// date is later corrected upstream.
  uploadedAt DateTime
  postedAt   DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per pair, so re-running a match updates rather than duplicates.
  @@unique([submissionId, reelId])
  @@index([campaignId, active])
  @@index([campaignId, active, origin])
}

/// Outcome band for one compared pair, straight from the engine's own bands:
/// MATCH >= 90, LIKELY_MATCH 60-89.9, UNCERTAIN 25-59.9, NO_MATCH < 25. The
/// raw score is stored beside it, but this is the field to branch on.
enum ComparisonVerdict {
  MATCH
  LIKELY_MATCH
  UNCERTAIN
  NO_MATCH
}

/// Lifecycle of one comparison job. The first four terminal states are the
/// engine's own; the last two are ours.
enum ComparisonStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  /// Some videos failed to prepare — the rest were still compared.
  PARTIAL
  FAILED
  /// The engine timed out, or we gave up waiting on it.
  TIMEOUT
  /// A newer run over the same campaign replaced this one mid-flight.
  SUPERSEDED
}

/// One classification batch over a campaign's submissions: one or more
/// candidate videos checked, in arrival order, against the campaign's baseline
/// (its UNIQUE and PARTIAL videos). An upload is a batch of one, with
/// `triggerSubmissionId` set; a rebuild or a bulk arrival is a batch of many.
/// Pairs stored under a run are candidate-vs-baseline only.
model VideoComparison {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  status ComparisonStatus @default(QUEUED)

  /// The submission whose upload started this run, when one did. Null for a
  /// run an admin asked for by hand. A plain id, not a relation: it is a note
  /// about why the run happened, and must survive the submission being
  /// withdrawn.
  triggerSubmissionId String?

  /// Live progress, mirrored from the engine on every poll so the browser can
  /// show a real bar without talking to the engine itself. Frozen once
  /// terminal.
  stage     String?
  pairsDone Int     @default(0)

  /// Denormalised once the result lands, so the history list can be rendered
  /// without loading every pair. `flaggedPairCount` counts pairs that are not
  /// NO_MATCH — the ones a human might want to look at.
  pairsTotal       Int     @default(0)
  videoCount       Int     @default(0)
  flaggedPairCount Int     @default(0)
  engineVersion    String?

  /// Why the run failed, for FAILED and TIMEOUT. Null otherwise.
  errorMessage String?

  completedAt DateTime?

  /// Soft-delete flag — see User.active. Nothing flips it today: runs are an
  /// append-only record. It exists so clearing the history stays a soft
  /// delete, like everything else here.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The engine calls this run is made of, the videos that went in, and the
  /// pairs that came out.
  jobs    VideoComparisonJob[]
  entries VideoComparisonEntry[]
  pairs   VideoComparisonPair[]

  @@index([campaignId, active, createdAt])
  @@index([status])
}

/// One call to the engine inside a run.
///
/// The engine accepts a bounded number of URLs per request (4 by default), so
/// a candidate with a baseline larger than that takes several calls. Each
/// call pins the candidate first in `submissionIds` alongside a slice of the
/// baseline; pairs among the baseline videos themselves are discarded.
model VideoComparisonJob {
  id String @id @default(cuid())

  comparisonId String
  comparison   VideoComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  /// The engine's own job id, polled until terminal. Null when the request
  /// was rejected outright — there is no job behind such a row, only the
  /// error that stopped it being created.
  jobId String?

  status ComparisonStatus @default(QUEUED)

  /// The submissions this call compares: the candidate first, then the slice
  /// of the baseline it was checked against.
  submissionIds String[]

  stage        String?
  errorMessage String?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([comparisonId])
  @@index([jobId])
}

/// One video handed to the engine as part of a run.
///
/// Kept separate from the pairs because a video can be an input and still
/// contribute nothing: a file the engine could not download or decode comes
/// back `ready = false` and appears in no pair at all. Without this row the
/// UI could not tell "no duplicates" from "never actually compared".
model VideoComparisonEntry {
  id String @id @default(cuid())

  comparisonId String
  comparison   VideoComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  submissionId String
  submission   VideoSubmission @relation(fields: [submissionId], references: [id])

  /// The object-storage URL sent to the engine. Stored because the engine's
  /// pair keys reference videos by URL-derived key, and this is what maps one
  /// back to a submission.
  url String

  /// The engine's own key for this video (`<extractor>:<id>`), once known.
  engineKey String?

  /// Whether the engine got as far as fingerprinting it.
  ready Boolean @default(false)
  /// Probed from the normalised media, for the UI's duration readout.
  durationSeconds Float?

  @@unique([comparisonId, submissionId])
  @@index([submissionId])
}

/// The comparison of two videos from one run.
///
/// Rows exist for every pair the engine returned, NO_MATCH included: "these
/// two were checked and are unrelated" is a result, and dropping it would
/// make an unchecked pair indistinguishable from a clean one.
///
/// Which video is `a` and which is `b` is the engine's choice, not a sorted
/// order — `evidence` has an `a` side and a `b` side, and swapping them would
/// leave it describing the wrong videos. Score, verdict and containment are
/// all symmetric, so the unordered identity lives in `pairKey` instead, and
/// that is what the unique constraint uses — two jobs reporting the same two
/// videos in opposite orders must not produce two rows.
model VideoComparisonPair {
  id String @id @default(cuid())

  comparisonId String
  comparison   VideoComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  aSubmissionId String
  a             VideoSubmission @relation("ComparisonPairA", fields: [aSubmissionId], references: [id])
  bSubmissionId String
  b             VideoSubmission @relation("ComparisonPairB", fields: [bSubmissionId], references: [id])

  /// 0-100. Floored at 1.0 by the engine, so 1.0 means "no signal at all",
  /// not "1% similar".
  score   Float
  verdict ComparisonVerdict

  /// max(coverage_a, coverage_b) * 100 — the "is one of these lifted out of
  /// the other?" signal. Watch it when the two durations differ a lot: a
  /// short clip cut from a long video scores modestly but contains fully.
  containment Float @default(0)

  /// `"<lower id>|<higher id>"` — the unordered identity of this pair. The
  /// a/b columns keep the engine's own order; this is what makes "these two
  /// videos, in either order" a single row.
  pairKey String

  /// The engine's `evidence` block verbatim, for the detail view. Stored as
  /// JSON rather than exploded into columns: it is diagnostic detail that the
  /// engine is free to reshape between versions, and nothing queries into it.
  evidence Json?

  @@unique([comparisonId, pairKey])
  @@index([aSubmissionId])
  @@index([bSubmissionId])
}

/// Vendor contact record for the admin "Vendors" directory — the video editors
/// and other suppliers the team works with. A directory entry, NOT a login
/// account: accounts are `User` rows, and `Role.EDITOR` there is unrelated to
/// this model.
model Vendor {
  id    String  @id @default(cuid())
  name  String
  email String?
  /// Digits with an optional leading "+", exactly as the API validates it
  /// (separators stripped). Unique: the key bulk import dedupes on.
  phoneNumber String  @unique
  instagram   String?
  twitter     String?
  linkedin    String?

  /// Visible status toggle — NOT the soft-delete flag used by User/Campaign.
  /// Inactive vendors stay listed and can be re-activated; there is no
  /// DELETE endpoint for vendors.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Shares addressed to this vendor.
  shareRecipients VendorShareRecipient[]

  /// Post links this vendor sent back on WhatsApp.
  replyPosts VendorReplyPost[]

  @@index([active])
}

/// Outcome of one vendor's copy of a share.
enum VendorShareStatus {
  PENDING
  SENT
  /// Delivered confirmed by a Meta status webhook.
  DELIVERED
  FAILED
  /// No usable WhatsApp number — never attempted. See common/phone.ts.
  UNREACHABLE
}

/// One "send these videos to these vendors" action by an admin.
model VendorShare {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  createdById String
  createdBy   User   @relation("VendorShareAuthor", fields: [createdById], references: [id])

  /// What the admin typed, before links were appended.
  messageBody String

  /// The submissions shared, in the order they were selected. Plain ids: the
  /// record of what was sent must survive a submission being withdrawn.
  submissionIds String[]

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients VendorShareRecipient[]

  /// Post links vendors sent back in reply to this share.
  replyPosts VendorReplyPost[]

  @@index([campaignId, active, createdAt])
  @@index([createdById])
}

/// One vendor's copy of a share — the unit that actually gets sent and retried.
model VendorShareRecipient {
  id String @id @default(cuid())

  shareId String
  share   VendorShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  /// The number actually dialled: international digits, no "+". Null when the
  /// stored number could not be resolved, which is what UNREACHABLE means.
  waNumber String?

  status VendorShareStatus @default(PENDING)

  /// Meta's message id, for matching up status webhooks later.
  providerMessageId String?
  /// Whether this went out as free text or fell back to the template, so a
  /// reader can tell why the wording differs from what the admin typed.
  usedTemplate Boolean @default(false)

  errorMessage String?
  attempts     Int     @default(0)
  sentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shareId, vendorId])
  @@index([vendorId])
  /// The queue read: anything still owed a send, oldest first.
  @@index([status, createdAt])
}

/// One Instagram reel pulled from the external tracker for a campaign.
///
/// A creator's published post, NOT an editor's hand-in — the two never share a
/// table. A submission is a file in our own bucket; a reel is someone else's
/// media at a URL we only reference.
model CampaignReel {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  /// The tracker's own id, so a re-ingest updates in place.
  trackerPostId String

  /// The creator. `socialUsername` is verbatim from the tracker and is a URL
  /// ("https://instagram.com/cric_bold"); `username` is the handle parsed out
  /// of it, lowercased — that is what reads as the profile.
  socialUsername String
  username       String

  /// The post's permalink, and the direct media URL the engine fingerprints.
  ///
  /// `mediaUrl` is stored EXACTLY as the tracker gave it: the engine derives a
  /// video's cache identity from the URL, so normalising it here would orphan
  /// every fingerprint already stored against the old form.
  permalink String?
  mediaUrl  String

  /// SHA-256 of the reel's bytes, lowercase hex. See VideoSubmission for what
  /// this is and is not. Null until hashed.
  contentHash String?

  /// When it went live on Instagram. Null when upstream sent nothing usable.
  /// Half of the evidence a human needs to tell who posted first.
  postedAt DateTime?

  /// `Content-Length` and `ETag` of `mediaUrl`, from a HEAD at import time.
  /// Hetzner's ETag is the MD5 of a single-part object, so two reels with the
  /// same ETag are the same bytes and are labelled duplicates of each other
  /// without asking the engine. Null when the HEAD failed or predates the
  /// columns; a null is never treated as a match.
  mediaSizeBytes Int?
  mediaEtag      String?

  /// Engagement blob, verbatim. Display only, so JSON rather than columns.
  postCounts Json?

  caption         String?
  invoiceApproved Boolean @default(false)

  /// The label, or null — see VideoSubmission.uniqueness for the four states
  /// (`checkedAt` is the second half). Arrival order for reels is `postedAt`,
  /// then `createdAt`; a reel with no `postedAt` sorts after every reel that
  /// has one.
  uniqueness Uniqueness?

  /// Match value, 0-100: the highest max(score, containment) against any
  /// baseline reel posted before it. Stored even when below 25; 0 only when
  /// there was nothing to compare against. Null = not checked yet.
  duplicationScore Float?

  /// The baseline reel it scored highest against — the parent, when the label
  /// is not UNIQUE. A plain id, so it survives that reel being deactivated.
  originalReelId String?

  /// Derived: `uniqueness == UNIQUE`. Kept one release for the reels page;
  /// read `uniqueness` in new code.
  isOriginal Boolean @default(false)

  checkedAt DateTime?

  /// Soft-delete flag — see User.active. Set false when a post leaves the
  /// tracker feed, so past findings stay readable.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchPairs ReelMatchPair[]

  crossPlatformMatches CrossPlatformMatch[]
  frameSignatures VideoFrameSignature[]
  /// Replies from vendors that pointed at this reel.
  vendorReplyPosts VendorReplyPost[]

  @@unique([campaignId, trackerPostId])
  /// The cross-platform match: find the upload carrying these exact bytes.
  @@index([campaignId, contentHash])
  @@index([campaignId, active])
  @@index([campaignId, username])
  /// Backs the baseline query (UNIQUE and PARTIAL rows of a campaign).
  @@index([campaignId, active, uniqueness])
}

/// One "find matches" run over a campaign.
model ReelMatchRun {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  status ComparisonStatus @default(QUEUED)

  /// The score at or above which a pair counted as the same video, snapshotted
  /// so a later change cannot rewrite what this run concluded.
  threshold Float

  /// The reel whose arrival started this run, when exactly one did. Null for
  /// a rebuild or a bulk import. A plain id — see VideoComparison.
  triggerReelId String?

  /// Denormalised once the run lands, so a history row renders without
  /// loading a pair.
  reelCount       Int @default(0)
  submissionCount Int @default(0)
  pairsDone       Int @default(0)
  pairsTotal      Int @default(0)
  matchCount      Int @default(0)

  errorMessage String?
  completedAt  DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs  ReelMatchJob[]
  pairs ReelMatchPair[]

  @@index([campaignId, active, createdAt])
  @@index([status])
}

/// One engine call inside a run.
///
/// A call carries one submission pinned alongside a slice of the campaign's
/// reels, so every needed pair is covered exactly once — unlike the submission
/// comparison, which is quadratic and needs overlapping batches.
model ReelMatchJob {
  id String @id @default(cuid())

  runId String
  run   ReelMatchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// The engine's own job id, polled until terminal. Null when the request was
  /// rejected outright — there is no job behind such a row.
  jobId String?

  status ComparisonStatus @default(QUEUED)

  /// The submission this call pins, and the reels it was compared against.
  submissionId String
  reelIds      String[]

  errorMessage String?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([jobId])
}

/// One editor video compared with one reel.
///
/// Only pairs worth looking at are stored: a campaign's full cross product is
/// mostly unrelated videos scoring 1.0, and keeping those would make this the
/// largest table in the database for no reader.
model ReelMatchPair {
  id String @id @default(cuid())

  runId String
  run   ReelMatchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  submissionId String
  submission   VideoSubmission @relation(fields: [submissionId], references: [id])

  reelId String
  reel   CampaignReel @relation(fields: [reelId], references: [id])

  /// 0-100, floored at 1.0 by the engine.
  score   Float
  verdict ComparisonVerdict

  /// Whether `score` met the run's threshold — i.e. the same video.
  matched Boolean @default(false)

  /// The engine's evidence block, so a borderline call is auditable rather
  /// than a bare yes/no.
  evidence Json?

  createdAt DateTime @default(now())

  @@unique([runId, submissionId, reelId])
  @@index([runId, matched, score])
  @@index([submissionId])
  @@index([reelId])
}
