DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yg_video_editor"
PORT=8700
JWT_SECRET=dev-only-insecure-secret-change-me

# Hetzner Object Storage (S3-compatible) — where submitted videos are stored.
# Without these the API still boots; the submission routes answer 503.
HETZNER_BUCKET_ACCESS_KEY=
HETZNER_BUCKET_SECRET_KEY=
HETZNER_BUCKET_NAME=meldit
HETZNER_BUCKET_REGION=fsn1
HETZNER_BUCKET_ENDPOINT=https://fsn1.your-objectstorage.com
